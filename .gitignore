# See https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# env — 機密與本機覆寫；正式值請在 Vercel / Convex 後台設定
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 若要範本可新增並提交 .env.example（上列規則不會忽略它）

# vercel（CLI 連結專案時產生，含專案 id，不需進 repo）
.vercel

# debug / tooling
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.eslintcache

# typescript
*.tsbuildinfo

# IDE / OS
.idea/
Thumbs.db
Desktop.ini
